BOT_TOKEN=put_your_telegram_bot_token_here
ECHOCHAIN_DB_PATH=data/echochain.sqlite3

# Telegram channel integration
# Add the bot to your channel as an administrator with permission to post messages.
CHANNEL_CHAT_ID=@your_channel_username
# Numeric Telegram user ID allowed to approve important channel posts.
OWNER_ID=your_telegram_user_id

# Public HTTPS address of the Mini App (leave empty until hosting is configured).
WEBAPP_URL=
# HTTP listener; set PORT to the port assigned by your hosting provider.
HOST=0.0.0.0
PORT=8080
